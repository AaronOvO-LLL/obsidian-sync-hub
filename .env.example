# 复制为 .env 并填入真实值。.env 已被 .gitignore 忽略，切勿提交。

# 同步中枢的域名（需已解析 A 记录到服务器 IP；移动端要求 HTTPS，必须用域名）
SYNC_DOMAIN=sync.example.com

# Let's Encrypt 证书到期提醒邮箱（可随便填，但别留空）
ACME_EMAIL=you@example.com

# CouchDB 管理员账号（请用强密码）
COUCHDB_USER=admin
COUCHDB_PASSWORD=change-me-strong-password

# 可选：CouchDB 数据库名（默认 obsidian；也可在 init.sh 里指定）
# DB_NAME=obsidian
